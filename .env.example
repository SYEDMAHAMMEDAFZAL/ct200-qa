# SQLite database for documents, versions, nodes and selections
DATABASE_URL=sqlite:///var/ct200.db
# JSON document store for LLM generations (TinyDB file)
GENERATION_STORE_PATH=var/generations.json
# LLM provider: "mock" (default, offline) or "openai_compat" (Groq / OpenRouter / Gemini OpenAI endpoint)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_MAX_ATTEMPTS=3
# Optional: set to 1 to OCR every page and compare it with the text layer during ingestion
OCR_CROSSCHECK=0
